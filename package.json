{
  "name": "zombie-rush-mobile",
  "version": "1.2.0",
  "private": true,
  "description": "Zombie Rush 3D – mobile Web-/Capacitor-App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prepare:web": "node scripts/prepare-web.js",
    "cap:sync": "npm run prepare:web && npx cap sync",
    "cap:open:android": "npm run cap:sync && npx cap open android",
    "cap:open:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
